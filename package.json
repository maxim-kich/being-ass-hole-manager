{
  "name": "being-ass-hole-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && wrangler dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply bahm-assessments --local",
    "build": "npm run share:build && wrangler deploy --dry-run --outdir .build",
    "deploy": "npm run share:build && wrangler deploy",
    "test": "node --test tests/*.test.js",
    "share:build": "node scripts/build-home-share.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20260926.0-alpha",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@cf-wasm/resvg": "^0.4.0"
  }
}
